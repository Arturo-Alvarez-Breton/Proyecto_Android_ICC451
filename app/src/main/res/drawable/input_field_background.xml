<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/input_field_background" />
            <stroke
                    android:width="2dp"
                    android:color="@color/input_field_stroke_focused" />
            <padding
                    android:left="16dp"
                    android:top="12dp"
                    android:right="16dp"
                    android:bottom="12dp" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/input_field_background" />
            <stroke
                    android:width="1dp"
                    android:color="@color/input_field_stroke" />
            <padding
                    android:left="16dp"
                    android:top="12dp"
                    android:right="16dp"
                    android:bottom="12dp" />
        </shape>
    </item>
</selector>
