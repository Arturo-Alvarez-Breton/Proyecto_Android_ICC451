<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".GroupInfoActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/primary"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/baseline_arrow_back_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:tint="@android:color/white"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Group Photo Section -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:gravity="center">

                <!-- Circular Image View for Group Photo -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imageViewGroupPhoto"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_group_placeholder"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto del grupo"
                    android:background="@color/primary_light"
                    app:shapeAppearanceOverlay="@style/CircleImageView"/>

                <!-- Edit Photo Button -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/buttonEditPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|bottom|end"
                    android:layout_marginEnd="60dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/ic_camera"
                    app:fabSize="mini"
                    app:tint="@android:color/white"
                    android:contentDescription="Cambiar foto"/>

                <!-- Remove Photo Button -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/buttonRemovePhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|bottom|start"
                    android:layout_marginStart="60dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/ic_delete"
                    app:fabSize="mini"
                    app:backgroundTint="@android:color/holo_red_dark"
                    app:tint="@android:color/white"
                    android:contentDescription="Quitar foto"
                    android:visibility="gone"/>

            </FrameLayout>

            <!-- Group Name -->
            <TextView
                android:id="@+id/textViewGroupName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del Grupo"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:padding="8dp"/>

            <!-- Participant Count -->
            <TextView
                android:id="@+id/textViewParticipantCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 participantes"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray"
                android:gravity="center"
                android:paddingBottom="16dp"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/darker_gray"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <!-- Participants Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Participantes"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:padding="16dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewParticipants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_group_participant"/>

        </LinearLayout>

    </ScrollView>

    <!-- FAB to Add Participants -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddParticipant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_person_add_24"
        android:contentDescription="Agregar participante"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"
        app:tint="@android:color/white"/>

</androidx.constraintlayout.widget.ConstraintLayout>
