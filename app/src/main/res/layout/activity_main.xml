<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity"
        android:background="@color/background_primary">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_tool_bar" >

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_on_surface"
                android:textSize="24sp"
                android:textStyle="bold"
                android:id="@+id/tvUsername"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="8dp"/>

<!--        <Button-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="36dp"-->
<!--                android:text="@string/btn_logout"-->
<!--                android:id="@+id/btnLogout"-->
<!--                android:backgroundTint="@color/btn_logout"-->
<!--                android:textColor="@color/white"-->
<!--                app:layout_constraintTop_toTopOf="parent"-->
<!--                android:layout_marginTop="4dp"-->
<!--                android:layout_marginStart="16dp"-->
<!--                app:layout_constraintStart_toEndOf="@+id/tvUsername"/>-->

        <com.google.android.material.button.MaterialButton
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:id="@+id/btnSettings"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/btn_menu"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:icon="@drawable/baseline_menu_24"
                app:iconTint="@color/text_on_surface"
                app:iconGravity="textEnd"
                app:iconSize="28dp"
                android:visibility="visible"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/background_search_bar"
            android:layout_below="@id/toolBar">

        <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:id="@+id/chatSearchField"
                android:hint="@string/input_search_bar"
                android:inputType="text"
                android:background="@drawable/input_field_background"
                android:textColor="@color/input_field"
                android:textColorHint="@color/input_field_hint"
                android:textSize="16sp"
                android:minHeight="48dp"/>

    </LinearLayout>

    <LinearLayout
            android:id="@+id/chatsFilters"
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_below="@id/searchBar"
            android:padding="8dp">

        <Button
                android:id="@+id/btnAllChatsFilter"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/btn_chats_filters_active"
                android:textColor="@color/text_on_btn_chats_filters"
                android:text="@string/btn_all_chats_filter"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="0dp"/>

        <Button
                android:id="@+id/btnGroupChatsFilter"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/btn_chats_filters_inactive"
                android:textColor="@color/text_on_btn_chats_filters"
                android:text="@string/btn_groups_chats_filter"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="5dp"/>

        <Button
                android:id="@+id/btnContactsChatsFilter"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/btn_chats_filters_inactive"
                android:textColor="@color/text_on_btn_chats_filters"
                android:text="@string/btn_contacts_chats_filter"
                android:layout_marginStart="5dp"/>

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_below="@id/chatsFilters">

        <!-- RecyclerView para mostrar la lista de chats -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewChats"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:clipToPadding="false"
            android:paddingVertical="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Incluir el menú FAB -->
        <include
                layout="@layout/fab_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</RelativeLayout>